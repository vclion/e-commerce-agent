DATABASE_URL=postgresql+psycopg://commerce:CHANGE_ME@127.0.0.1:55432/commerce
POSTGRES_PASSWORD=CHANGE_ME
DEMO_PASSWORD=CHANGE_ME
TOOL_SERVICE_KEY=CHANGE_ME
DIFY_BASE_URL=http://127.0.0.1:8088/v1
DIFY_OPERATOR_KEY=
DIFY_KNOWLEDGE_KEY=
DIFY_PUBLIC_DATASET=
DIFY_INTERNAL_DATASET=
PLATFORM_WORKER_ENABLED=true
# Optional Fernet key. If empty, a private key is generated in .runtime/platform-encryption.key.
# Preserve that key when moving the database; no real platform credentials are bundled.
PLATFORM_ENCRYPTION_KEY=
# Memory uses an external, OpenAI-compatible embedding API supplied by the operator.
# Leave URL/model/dimensions unset to use structured and keyword memory only. No local model starts.
MEMORY_ENABLED=true
MEMORY_WORKER_ENABLED=true
# Set false to pause external embedding calls while preserving URL/model/key configuration.
MEMORY_EMBEDDING_ENABLED=true
MEMORY_EMBEDDING_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIMENSIONS=0
# Change revision when the provider changes weights under the same model name.
MEMORY_EMBEDDING_REVISION=v1
MEMORY_EMBEDDING_QUERY_TIMEOUT=1.5
MEMORY_EMBEDDING_INDEX_TIMEOUT=30
# Indexed context. Token counts use a conservative UTF-8 byte upper bound without downloads.
MEMORY_CONTEXT_TOKENS=32000
MEMORY_MODEL_CONTEXT_TOKENS=65536
# Reserve for fixed instructions, tools/results and model output; tune for your deployed model.
MEMORY_RESERVED_TOKENS=16384
MEMORY_RECENT_TURNS=3
MEMORY_LIGHT_TURNS=0
MEMORY_SEGMENT_TURNS=8
MEMORY_INDEX_ACTIVE_LIMIT=3
MEMORY_INDEX_IDLE_TURNS=24
MEMORY_INDEX_IDLE_DAYS=7
MEMORY_INDEX_CONTEXT_TOKENS=2400
MEMORY_TASK_STATE_TOKENS=1200
MEMORY_LONG_CONTEXT_TOKENS=2400
# Per-request fallback; at most one compaction per phase and one pre-tool provider retry.
MEMORY_REACTIVE_ENABLED=true
MEMORY_REACTIVE_SUMMARY_TOKENS=1600
MEMORY_REACTIVE_INPUT_TOKENS=48000
MEMORY_REACTIVE_TIMEOUT=20
MEMORY_REACTIVE_RETRY_RATIO=0.6
